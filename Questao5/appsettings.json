{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseName": "Data Source=.data/database.sqlite;Foreign Keys=True",
  "Movement": {
    "TimeoutSeconds": 5,
    "EndpointPermitLimit": 30,
    "GlobalPermitLimit": 120,
    "WindowSeconds": 60,
    "ConcurrencyPermitLimit": 8
  },
  "Balance": {
    "TimeoutSeconds": 5,
    "EndpointPermitLimit": 30,
    "WindowSeconds": 60,
    "ConcurrencyPermitLimit": 8
  }
}
